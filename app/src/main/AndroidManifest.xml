<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartPantryManager"
        android:supportsRtl="true">

        <activity
            android:name=".PantryListActivity"
            android:label="@string/title_pantry"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AddEditIngredientActivity" android:label="@string/title_add_item" android:exported="false" />
        <activity android:name=".SuggestedRecipesActivity" android:label="@string/title_suggested_recipes" android:exported="false" />
        <activity android:name=".RecipeDetailActivity" android:label="@string/title_recipe_detail" android:exported="false" />
        <activity android:name=".SettingsActivity" android:label="@string/title_settings" android:exported="false" />

    </application>

</manifest>
